{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@math/*": ["src/math/*"],
      "@physics/*": ["src/physics/*"],
      "@vehicle/*": ["src/vehicle/*"],
      "@track/*": ["src/track/*"],
      "@race/*": ["src/race/*"],
      "@network/*": ["src/network/*"],
      "@debug/*": ["src/debug/*"],
      "@proxy/*": ["src/proxy/*"],
      "@ui/*": ["src/ui/*"],
      "@audio/*": ["src/audio/*"],
      "@assets/*": ["src/assets/*"],
      "@core/*": ["src/core/*"]
    },
    "tsBuildInfoFile": ".cache/.tsbuildinfo.client"
  },
  "include": [
    "src/client/**/*.ts",
    "src/proxy/**/*.ts",
    "src/debug/**/*.ts",
    "src/ui/**/*.ts",
    "src/audio/**/*.ts",
    "src/assets/**/*.ts",
    "src/shared/**/*.ts",
    "src/math/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".cache",
    "server/**/*",
    "src/core/**/*",
    "src/physics/**/*",
    "src/vehicle/**/*",
    "src/track/**/*",
    "src/race/**/*",
    "src/network/**/*",
    "src/ai/**/*",
    "tests/**/*"
  ]
}
